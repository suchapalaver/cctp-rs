# CCTP Testnet Configuration
# Copy this file to .env and fill in your values

# Required: Your wallet private key (include the 0x prefix)
TESTNET_PRIVATE_KEY=0x...

# Required unless both RPC URL overrides are set: Alchemy API key for RPC access
TESTNET_API_KEY=your-alchemy-api-key

# Optional: funded example route. Defaults to arbitrum-sepolia -> base-sepolia.
# Supported aliases: sepolia, arbitrum-sepolia, base-sepolia,
# optimism-sepolia, avalanche-fuji, polygon-amoy
# SOURCE_CHAIN=arbitrum-sepolia
# DESTINATION_CHAIN=base-sepolia

# Optional: generic full RPC URL overrides. These take precedence over
# chain-specific RPC URL variables and TESTNET_API_KEY-derived Alchemy URLs.
# SOURCE_RPC_URL=https://...
# DESTINATION_RPC_URL=https://...

# Optional: full chain-specific RPC URL overrides
# BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
# ARBITRUM_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_KEY
# SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# OPTIMISM_SEPOLIA_RPC_URL=https://opt-sepolia.g.alchemy.com/v2/YOUR_KEY
# AVALANCHE_FUJI_RPC_URL=https://avax-fuji.g.alchemy.com/v2/YOUR_KEY
# POLYGON_AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_KEY

# Optional: USDC token address overrides for newly supported testnets
# SOURCE_USDC_ADDRESS=0x...
# DESTINATION_USDC_ADDRESS=0x...

# Safety switch: examples only submit approval/burn/mint transactions when true.
# EXECUTE_TRANSFER=true
